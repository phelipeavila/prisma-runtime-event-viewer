# Required if you want to skip the in-UI login form.
PRISMA_CONSOLE_URL=https://console.example.com

# Auth — provide EITHER a pre-issued bearer token...
# PRISMA_API_TOKEN=eyJhbGciOi...

# ...OR an API key + secret (the app will exchange them at startup).
# PRISMA_API_KEY=
# PRISMA_API_SECRET=

# TLS verification toggle (default: true).
# PRISMA_VERIFY_TLS=true

# Ingest tuning. Prisma's per-page row cap is 100 and is NOT configurable.
# FETCH_CHUNKS=8
# FETCH_MAX_CONCURRENCY=8
# FETCH_MAX_RETRIES=5

# DuckDB tuning.
# DUCKDB_THREADS=4
# DUCKDB_MEMORY_LIMIT=4GB
# DUCKDB_KEEP_RAW_JSON=true

# Bind address.
# BIND_HOST=0.0.0.0
# BIND_PORT=8000
